// =====================================================================================
// PRISMA SCHEMA
// =====================================================================================
// Database   : Supabase PostgreSQL
// ORM        : Prisma
// 
// Notes:
//   - The `User` model syncs with Supabase Auth `auth.users` via SQL Trigger.
//   - ID uses UUID to match auth.users, handled by application logic without FK.
//   - Soft deletes use `deletedAt`.
//   - `TransactionItem` stores snapshots (name, price) to preserve history.
// =====================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ENUMS

enum UserRole {
  OWNER
  ADMIN
  CASHIER

  @@map("user_role")
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  QRIS
  E_WALLET
  BANK_TRANSFER
  OTHER

  @@map("payment_method")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED

  @@map("transaction_status")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  REFUND_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL

  @@map("stock_movement_type")
}

enum StockMovementRefType {
  TRANSACTION
  MANUAL
  PURCHASE_ORDER
  STOCK_OPNAME

  @@map("stock_movement_ref_type")
}

// USER (SYNCED WITH SUPABASE AUTH)

model User {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String    @map("full_name")
  phone     String?
  role      UserRole  @default(CASHIER)
  avatarUrl String?   @map("avatar_url")
  isActive  Boolean   @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  transactions   Transaction[]      @relation("CashierTransactions")
  stockMovements StockMovement[]    @relation("UserStockMovements")
  auditLogs      AuditLog[]
  refundsHandled RefundTransaction[] @relation("RefundHandledBy")
  chatSessions   AiChatSession[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

// CATEGORIES

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  imageUrl    String? @map("image_url")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@index([deletedAt])
  @@map("categories")
}

// PRODUCTS

model Product {
  id         String  @id @default(uuid()) @db.Uuid
  sku        String  @unique
  barcode    String? @unique
  name       String
  categoryId String  @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String?
  imageUrl    String? @map("image_url")

  costPrice Decimal @map("cost_price") @db.Decimal(14, 2)
  sellPrice Decimal @map("sell_price") @db.Decimal(14, 2)

  unit     String @default("pcs")
  stock    Int    @default(0)
  minStock Int    @default(5) @map("min_stock")

  isActive Boolean @default(true) @map("is_active")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  refundItems      RefundItem[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([name])
  @@index([stock])
  @@map("products")
}

// STOCK MOVEMENTS

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  type          StockMovementType    @map("type")
  refType       StockMovementRefType @default(MANUAL) @map("ref_type")
  referenceId   String?              @map("reference_id") @db.Uuid

  quantity     Int
  stockBefore  Int @map("stock_before")
  stockAfter   Int @map("stock_after")

  note String?

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation("UserStockMovements", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

// CUSTOMERS

model Customer {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  phone   String? @unique
  email   String? @unique
  address String?

  totalSpent        Decimal @default(0) @map("total_spent") @db.Decimal(14, 2)
  totalTransactions Int     @default(0) @map("total_transactions")
  loyaltyPoints     Int     @default(0) @map("loyalty_points")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  transactions Transaction[]

  @@index([deletedAt])
  @@index([name])
  @@map("customers")
}

// TRANSACTIONS

model Transaction {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique @map("invoice_number")

  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  cashierId String @map("cashier_id") @db.Uuid
  cashier   User   @relation("CashierTransactions", fields: [cashierId], references: [id], onDelete: Restrict)

  subtotal        Decimal @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  grandTotal      Decimal @map("grand_total") @db.Decimal(14, 2)

  paymentMethod PaymentMethod      @map("payment_method")
  paidAmount    Decimal            @map("paid_amount") @db.Decimal(14, 2)
  changeAmount  Decimal            @default(0) @map("change_amount") @db.Decimal(14, 2)
  status        TransactionStatus  @default(COMPLETED)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   TransactionItem[]
  refunds RefundTransaction[]



  @@index([cashierId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("transactions")
}

// TRANSACTION ITEMS (SNAPSHOTS)

model TransactionItem {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String  @map("product_name")
  sku         String
  costPrice   Decimal @map("cost_price") @db.Decimal(14, 2)
  sellPrice   Decimal @map("sell_price") @db.Decimal(14, 2)

  quantity       Int
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal       Decimal @db.Decimal(14, 2)

  refundedQty Int @default(0) @map("refunded_qty")

  createdAt DateTime @default(now()) @map("created_at")

  refundItems RefundItem[]

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

// REFUNDS

model RefundTransaction {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  handledById String @map("handled_by_id") @db.Uuid
  handledBy   User   @relation("RefundHandledBy", fields: [handledById], references: [id], onDelete: Restrict)

  reason      String
  totalAmount Decimal @map("total_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  items RefundItem[]

  @@index([transactionId])
  @@index([createdAt])
  @@map("refund_transactions")
}

model RefundItem {
  id       String @id @default(uuid()) @db.Uuid
  refundId String @map("refund_id") @db.Uuid
  refund   RefundTransaction @relation(fields: [refundId], references: [id], onDelete: Cascade)

  transactionItemId String           @map("transaction_item_id") @db.Uuid
  transactionItem   TransactionItem  @relation(fields: [transactionItemId], references: [id], onDelete: Restrict)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int
  amount   Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([refundId])
  @@index([transactionItemId])
  @@map("refund_items")
}

// AUDIT LOGS

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// STORE SETTINGS

model StoreSetting {
  id String @id @default(uuid()) @db.Uuid

  storeName    String  @map("store_name")
  address      String?
  phone        String?
  email        String?
  logoUrl      String? @map("logo_url")
  receiptFooter String? @map("receipt_footer")

  defaultTaxPercent Decimal @default(0) @map("default_tax_percent") @db.Decimal(5, 2)
  currency          String  @default("IDR")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// AI CHAT SESSIONS

model AiChatSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String @default("Sesi Baru")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AiChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String        @map("session_id") @db.Uuid
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    String
  content String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("ai_chat_messages")
}
